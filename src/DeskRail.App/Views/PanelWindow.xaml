<Window x:Class="DeskRail.App.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DeskRail.App.Converters"
        xmlns:core="clr-namespace:DeskRail.Core.Models;assembly=DeskRail.Core"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/DeskRail.App;component/Assets/DeskRail.ico"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="{Binding PanelVM.PanelWidth}"
        Height="{Binding PanelVM.PanelHeight}"
        PreviewMouseMove="OnResizeMove"
        PreviewMouseLeftButtonUp="OnResizeEnd"
        Left="0"
        Top="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:FileTypeToBrushConverter x:Key="TypeToBrush"/>
        <conv:SortKeyConverter x:Key="SortKeyConverter"/>
        <conv:ViewModeToBooleanConverter x:Key="ViewModeToBooleanConverter"/>
        <conv:GridGapToThicknessConverter x:Key="GridGapToThicknessConverter"/>
        <conv:PngBytesToImageSourceConverter x:Key="PngBytesToImageSourceConverter"/>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarToggleStyle" TargetType="{x:Type primitives:ToggleButton}">
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:ToggleButton}">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid x:Name="PanelRoot" ClipToBounds="True">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PanelTranslation" X="-520"/>
            </Grid.RenderTransform>
            <!-- 磨砂玻璃背景层 -->
            <Border x:Name="GlassBackground">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                    </Style>
                </Border.Style>
            </Border>

            <!-- 右边缘分隔线 -->
            <Border Width="1" HorizontalAlignment="Right" Background="{DynamicResource DividerBrush}"/>

            <!-- 内容区域 -->
            <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="24,16,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#00E5A0" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="DeskRail" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="◐" Style="{StaticResource HeaderButtonStyle}"
                            Click="OnToggleGlassMode" ToolTip="切换面板主题"/>
                    <Button Content="↕" Style="{StaticResource HeaderButtonStyle}"
                            Command="{Binding IconGridVM.ToggleSortCommand}"
                            CommandParameter="{Binding IconGridVM.SortKey}" ToolTip="切换排序方向"/>
                    <Button Content="⟳" Style="{StaticResource HeaderButtonStyle}"
                            Command="{Binding IconGridVM.RefreshCommand}" ToolTip="刷新"/>
                    <Button Content="×" Style="{StaticResource HeaderButtonStyle}" Margin="0"
                            Click="OnClosePanel" ToolTip="关闭"/>
                </StackPanel>
            </Grid>

            <!-- SearchBox -->
            <Border Grid.Row="1" Margin="24,0,24,6" Height="40" CornerRadius="9"
                    Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="⌕" Margin="13,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="21"/>
                    <TextBlock Text="搜索桌面图标、文件、目录..." Margin="42,0,12,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource PlaceholderBrush}" FontSize="12" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IconGridVM.SearchQuery}" Value=""/>
                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchInput}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="SearchInput" Margin="42,0,12,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalContentAlignment="Center" CaretBrush="#00E5A0"
                             Text="{Binding IconGridVM.SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>

            <!-- ControlsBar (间距滑块) -->
            <Grid Grid.Row="2" Margin="24,2,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="列间距" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Minimum="4" Maximum="40" Value="{Binding IconGridVM.ColGap}"
                        VerticalAlignment="Center" Margin="2,0,5,0" Foreground="#00E5A0"/>
                <TextBlock Grid.Column="2" Text="{Binding IconGridVM.ColGap, StringFormat={}{0:F0}}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="行间距" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Slider Grid.Column="4" Minimum="4" Maximum="40" Value="{Binding IconGridVM.RowGap}"
                        VerticalAlignment="Center" Margin="10,0,5,0" Foreground="#00E5A0"/>
                <TextBlock Grid.Column="5" Text="{Binding IconGridVM.RowGap, StringFormat={}{0:F0}}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- SortToolbar -->
            <Grid Grid.Row="3" Margin="24,0,24,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <controls:RadioButton GroupName="SortOptions" Style="{StaticResource ToolbarToggleStyle}"
                                           IsChecked="{Binding IconGridVM.SortKey, Mode=OneWay, Converter={StaticResource SortKeyConverter}, ConverterParameter=Name}"
                                           Command="{Binding IconGridVM.ToggleSortCommand}" CommandParameter="{x:Static core:SortKey.Name}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="A" FontWeight="Bold" Margin="0,0,6,0"/><TextBlock Text="名称"/></StackPanel>
                    </controls:RadioButton>
                    <controls:RadioButton GroupName="SortOptions" Style="{StaticResource ToolbarToggleStyle}"
                                           IsChecked="{Binding IconGridVM.SortKey, Mode=OneWay, Converter={StaticResource SortKeyConverter}, ConverterParameter=Type}"
                                           Command="{Binding IconGridVM.ToggleSortCommand}" CommandParameter="{x:Static core:SortKey.Type}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◆" FontSize="9" Margin="0,0,6,0"/><TextBlock Text="类型"/></StackPanel>
                    </controls:RadioButton>
                    <controls:RadioButton GroupName="SortOptions" Style="{StaticResource ToolbarToggleStyle}"
                                           IsChecked="{Binding IconGridVM.SortKey, Mode=OneWay, Converter={StaticResource SortKeyConverter}, ConverterParameter=Size}"
                                           Command="{Binding IconGridVM.ToggleSortCommand}" CommandParameter="{x:Static core:SortKey.Size}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◧" FontSize="10" Margin="0,0,6,0"/><TextBlock Text="大小"/></StackPanel>
                    </controls:RadioButton>
                    <controls:RadioButton GroupName="SortOptions" Style="{StaticResource ToolbarToggleStyle}" Margin="0"
                                           IsChecked="{Binding IconGridVM.SortKey, Mode=OneWay, Converter={StaticResource SortKeyConverter}, ConverterParameter=Date}"
                                           Command="{Binding IconGridVM.ToggleSortCommand}" CommandParameter="{x:Static core:SortKey.Date}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="日期"/></StackPanel>
                    </controls:RadioButton>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <primitives:ToggleButton Style="{StaticResource ToolbarToggleStyle}" Padding="7,0" Margin="0,0,4,0"
                                           IsChecked="{Binding IconGridVM.ViewMode, Mode=OneWay, Converter={StaticResource ViewModeToBooleanConverter}, ConverterParameter=Grid}"
                                           Tag="{x:Static core:ViewMode.Grid}" Click="OnSelectViewMode" ToolTip="网格视图">
                        <TextBlock Text="▦" FontSize="16"/>
                    </primitives:ToggleButton>
                    <primitives:ToggleButton Style="{StaticResource ToolbarToggleStyle}" Padding="7,0" Margin="0"
                                           IsChecked="{Binding IconGridVM.ViewMode, Mode=OneWay, Converter={StaticResource ViewModeToBooleanConverter}, ConverterParameter=List}"
                                           Tag="{x:Static core:ViewMode.List}" Click="OnSelectViewMode" ToolTip="列表视图">
                        <TextBlock Text="☷" FontSize="16"/>
                    </primitives:ToggleButton>
                </StackPanel>
            </Grid>

            <!-- IconGrid -->
            <Border Grid.Row="3" Height="1" Margin="16,0" VerticalAlignment="Bottom" Background="{DynamicResource DividerBrush}"/>
            <ScrollViewer Grid.Row="4" Margin="16,7,16,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding IconGridVM.FilteredItems}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IconGridVM.ViewMode}" Value="{x:Static core:ViewMode.List}">
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4" CornerRadius="6" MouseDown="OnIconClick"
                                    ContextMenuOpening="OnNativeContextMenuOpening">
                                <Border.Margin>
                                    <MultiBinding Converter="{StaticResource GridGapToThicknessConverter}">
                                        <Binding Path="DataContext.IconGridVM.ColGap" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                        <Binding Path="DataContext.IconGridVM.RowGap" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                    </MultiBinding>
                                </Border.Margin>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Width" Value="72"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IconGridVM.ViewMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="{x:Static core:ViewMode.List}">
                                                <Setter Property="Width" Value="Auto"/>
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                <Setter Property="Background" Value="{DynamicResource ListItemBackgroundBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ItemHoverBackgroundBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.08" ScaleY="1.08" CenterX="36" CenterY="36"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel x:Name="ItemContent" HorizontalAlignment="Center">
                                    <Image x:Name="ItemImage" Width="40" Height="40" Stretch="Uniform"
                                           Source="{Binding IconSource, Converter={StaticResource PngBytesToImageSourceConverter}}"/>
                                    <TextBlock x:Name="ItemLabel" Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" Margin="0,6,0,0" MaxHeight="30"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IconGridVM.ViewMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                             Value="{x:Static core:ViewMode.List}">
                                    <Setter TargetName="ItemContent" Property="Orientation" Value="Horizontal"/>
                                    <Setter TargetName="ItemContent" Property="HorizontalAlignment" Value="Left"/>
                                    <Setter TargetName="ItemImage" Property="Width" Value="32"/>
                                    <Setter TargetName="ItemImage" Property="Height" Value="32"/>
                                    <Setter TargetName="ItemImage" Property="Margin" Value="0,0,12,0"/>
                                    <Setter TargetName="ItemLabel" Property="TextAlignment" Value="Left"/>
                                    <Setter TargetName="ItemLabel" Property="VerticalAlignment" Value="Center"/>
                                    <Setter TargetName="ItemLabel" Property="Margin" Value="0"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="4" Margin="24" Text="{Binding IconGridVM.EmptyStateMessage}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IconGridVM.FilteredItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- StatusBar -->
            <Border Grid.Row="5" Height="1" VerticalAlignment="Top" Background="{DynamicResource DividerBrush}"/>
            <Grid Grid.Row="5" Margin="24,10,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding IconGridVM.FilteredItems.Count, StringFormat={}{0} 个项目}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                <TextBlock Grid.Column="1" Text="DeskRail v1.0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
            </Grid>
            </Grid>
        </Grid>

        <!-- 右边缘拖拽调宽手柄 -->
        <Border x:Name="ResizeGrip" Width="14" HorizontalAlignment="Right" Background="Transparent"
                Panel.ZIndex="10" Cursor="SizeWE" PreviewMouseLeftButtonDown="OnResizeStart"
                IsHitTestVisible="{Binding PanelVM.IsOpen}"
                Visibility="{Binding PanelVM.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                ToolTip="拖动以调整面板宽度">
            <Border Width="2" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="1" Background="{DynamicResource AccentBorderBrush}" Opacity="0.55"
                    IsHitTestVisible="False"/>
        </Border>
    </Grid>
</Window>
