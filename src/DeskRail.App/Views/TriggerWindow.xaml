<Window x:Class="DeskRail.App.Views.TriggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/DeskRail.App;component/Assets/DeskRail.ico"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="14" Height="600"
        Left="0" Top="300">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#00E5A0"/>
    </Window.Resources>

    <Grid x:Name="TriggerHitArea" Background="Transparent"
          MouseEnter="OnTriggerMouseEnter" MouseLeave="OnTriggerMouseLeave">
        <Border x:Name="TriggerLine" Opacity="0.72"
                HorizontalAlignment="Left"
                Background="{StaticResource AccentBrush}"
                CornerRadius="0,3,3,0">
            <Border.Effect>
                <DropShadowEffect x:Name="TriggerGlow" Color="#00E5A0"
                                  BlurRadius="9" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="2"/>
                </Style>
            </Border.Style>
        </Border>
    </Grid>

</Window>
